<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog Page</title>
</head>
<body>
    <%- include('./partials/nav') %>

    <div class="main-shell">
        <div class="page-header">
            <h1><%= blog.title %></h1>
        </div>

        <div class="blog-hero mb-4">
            <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>">
        </div>

        <div class="d-flex align-items-center gap-2 mb-4">
            <img src="<%= blog.createdBy.profileImageURL %>" class="avatar" alt="Author image">
            <div>
                <strong><%= blog.createdBy.fullName %></strong>
            </div>
        </div>

        <div class="blog-body mb-5"><%= blog.body %></div>

        <div class="content-panel p-4">
            <h3 class="mb-3">Comments (<%= comments.length %>)</h3>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
                    <div class="mb-3">
                        <input type="text" name="content" class="form-control" placeholder="Write a comment...">
                    </div>
                    <button type="submit" class="btn btn-primary">Add Comment</button>
                </form>
            <% } %>

            <div>
                <% comments.forEach(comment => { %>
                    <div class="comment-box d-flex gap-3 align-items-start">
                        <img src="<%= comment.createdBy.profileImageURL %>" class="avatar" alt="Comment author">
                        <div>
                            <div class="fw-bold mb-1"><%= comment.createdBy.fullName %></div>
                            <div class="blog-body" style="font-size: 0.98rem; margin: 0; white-space: normal;"><%= comment.content %></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <%- include('./partials/scripts') %>
</body>
</html>